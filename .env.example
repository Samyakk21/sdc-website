# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Public origin. Local dev: http://localhost:3000. Production: your Vercel domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Google Search Console verification token (HTML tag method).
# Adding it here is not required — Search Console also verifies via DNS.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=